# Copia este archivo a .env y llena los valores (NUNCA lo subas al repositorio)

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Autenticación (genera un secreto largo y aleatorio: openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Servidor
PORT=3000
NODE_ENV=development

# Origen permitido del frontend para CORS (separado por comas si hay varios)
FRONTEND_URL=http://localhost:5173

# Opcional: para geocodificación inversa de direcciones
GOOGLE_MAPS_API_KEY=